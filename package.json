{
  "name": "neuroflow",
  "description": "AI workspace and AI Code Agent on one production runtime: adaptive multi-agent routing, Model Gateway, safe tool execution, sandboxed tests and reviewable Git workflows.",
  "private": true,
  "license": "MIT",
  "author": "Tejasva Singh Chouhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejasvasingh2004/Tejasva_BCI_Cognitive-state-aware-multi-agent-system.git"
  },
  "homepage": "https://github.com/tejasvasingh2004/Tejasva_BCI_Cognitive-state-aware-multi-agent-system#readme",
  "bugs": {
    "url": "https://github.com/tejasvasingh2004/Tejasva_BCI_Cognitive-state-aware-multi-agent-system/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @neuroflow/api test:integration",
    "test:e2e": "pnpm --filter @neuroflow/web test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @neuroflow/db migrate",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "user:create": "pnpm --filter @neuroflow/db cli create-user",
    "user:password": "pnpm --filter @neuroflow/db cli set-password",
    "apikey:create": "pnpm --filter @neuroflow/db cli create-api-key",
    "keys:rewrap": "pnpm --filter @neuroflow/db cli rewrap-keys"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
