# =====================================================================
# BCI Adaptive Multi-Agent System — Environment Configuration Template
# =====================================================================

# --- LLM API Configuration (Ollama Local Instance) ---
# The URL of your local Ollama server.
# - Local development (outside Docker): Use http://localhost:11434
# - Docker container execution: Use http://host.docker.internal:11434 to resolve host system's localhost
OLLAMA_HOST=http://localhost:11434

# The name of the local LLM model to pull and execute via Ollama.
# Recommended model: qwen3:8b (or qwen2.5:7b / llama3:8b)
OLLAMA_MODEL=qwen3:8b

# GPU acceleration configurations for Ollama model execution.
# - Set to -1 to use default Ollama settings (highly recommended).
# - Set to 0 to force CPU execution.
# - Set to >0 to allocate a specific number of GPU layers.
OLLAMA_NUM_GPU=-1

# --- FastAPI Server Configuration ---
# The network address the FastAPI application should bind to.
# - 0.0.0.0: Bind to all interfaces (required for Docker).
# - 127.0.0.1: Bind to localhost only.
HOST=0.0.0.0

# The port number on which the backend server runs.
PORT=8000
