# =====================================================================
# NeuroFlow — environment configuration (copy to .env)
# =====================================================================

# --- Infrastructure (docker compose: `pnpm infra:up`) ---
DATABASE_URL=postgres://neuroflow:neuroflow@localhost:5433/neuroflow
REDIS_URL=redis://127.0.0.1:6380

# --- API ---
HOST=127.0.0.1
PORT=8080
# dev: passwordless dev login + DEV_API_KEY. production: email/password accounts (created with
# `pnpm user:create`) and API keys only.
AUTH_MODE=dev
# Required in production (>= 32 chars). Signs session cookies.
SESSION_SECRET=
# Optional: registers this key for the dev user so API clients can authenticate locally.
DEV_API_KEY=nf_dev_local_key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Rate limits, concurrency caps and daily token quotas come from each workspace's plan
# (free / pro / team / enterprise, see packages/contracts/src/plans.ts; change a plan with
# `pnpm --filter @neuroflow/db cli set-plan --email <owner> --plan pro`).
# The values below are optional overrides that apply to every plan (leave empty normally).
RATE_LIMIT_PER_MINUTE=
RUN_RATE_LIMIT_PER_MINUTE=
MAX_ACTIVE_RUNS_PER_WORKSPACE=
MAX_ACTIVE_RUNS_PER_USER=
# Daily model tokens per workspace; 0 = unlimited.
DAILY_TOKEN_QUOTA=
# Failed logins / invalid API keys allowed per client IP per window before requests get 429.
AUTH_FAILURE_LIMIT=20
AUTH_FAILURE_WINDOW_S=600
# Global back-pressure: queued runs beyond this are refused with 503.
MAX_QUEUE_BACKLOG=1000

# --- Worker ---
# Separate queues (bulkheads): runs, workspace (repo sync + terminal), evals (Model Lab).
WORKER_CONCURRENCY=4
WORKER_WORKSPACE_CONCURRENCY=4
WORKER_EVAL_CONCURRENCY=1
# Queues this process serves, e.g. "evals" on a dedicated evaluation node.
WORKER_QUEUES=runs,workspace,evals
# Optional override of the plan's per-workspace running cap (fair share of the worker pool).
MAX_RUNNING_PER_WORKSPACE=
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- Model Gateway: Qwen ---
# Local Ollama (default) or DashScope compatible-mode, e.g.
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (then set QWEN_API_KEY).
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=
# Comma separated model ids, optionally `id|tier|contextWindow`.
QWEN_MODELS=qwen3:8b

# --- Model Gateway: Groq ---
# Same `model|tier|contextWindow` syntax as QWEN_MODELS. On rate-limited tiers set the window to the
# per-request token limit (e.g. 8000 on Groq on_demand) so the runtime keeps every request below it:
#   GROQ_MODELS=openai/gpt-oss-120b|strong|8000,openai/gpt-oss-20b|balanced|8000
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3-32b

# --- Model Gateway policy ---
# Default model reference (<provider>/<model>); falls back to the first available model.
MODEL_DEFAULT=
# Global fallback chain, e.g. groq/openai/gpt-oss-120b
MODEL_FALLBACKS=
MODEL_MAX_RETRIES=2
MODEL_TIMEOUT_MS=180000
MODEL_FIRST_TOKEN_TIMEOUT_MS=90000
MODEL_IDLE_TIMEOUT_MS=30000
# Max concurrent model calls per provider (protects quotas / a local GPU), e.g. qwen=2,groq=16
MODEL_PROVIDER_CONCURRENCY=
# Provider budgets enforced before sending, shared by all workers through Redis.
# tpm/rpm are per API key (a comma-separated key pool in GROQ_API_KEY multiplies them).
# e.g. groq:tpm=8000,rpm=30,concurrency=8;qwen:concurrency=2
MODEL_PROVIDER_LIMITS=
# Longest wait for provider budget before falling back to the next model (ms).
MODEL_MAX_RATE_LIMIT_WAIT_MS=60000
# Circuit breaker: consecutive provider failures that open it, open period, max open period.
MODEL_CIRCUIT_FAILURES=5
MODEL_CIRCUIT_OPEN_MS=30000
MODEL_CIRCUIT_MAX_OPEN_MS=300000
# Pricing overrides, USD per 1M input:output tokens, e.g. groq/openai/gpt-oss-120b=0.15:0.6
# (Groq list prices are built in; local Ollama models are free.)
MODEL_PRICING=

# --- Tools: web search (optional; the web_search tool is only enabled when configured) ---
# WEB_SEARCH_PROVIDER=tavily | brave | searxng (defaults to whichever is configured)
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Self-hosted SearXNG with JSON output enabled, e.g. http://localhost:8888
SEARXNG_URL=

# --- Code workspaces (Product Phase 2) ---
# Repository checkouts + sandbox caches, shared by the API and the worker (same path for both).
# Defaults to <repo>/.data/code. With docker compose it must be a host path mounted at the same
# location, because the worker starts sandbox containers through the host Docker daemon.
CODE_DATA_DIR=
# Base64 32-byte key that encrypts stored GitHub credentials (required in production):
#   openssl rand -base64 32
SECRETS_KEY=
# GitHub OAuth App (optional — users can always connect with a fine-grained access token).
# Authorization callback URL: <PUBLIC_WEB_URL>/api/v1/github/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PUBLIC_WEB_URL=http://localhost:5173
# GitHub Enterprise Server: API and web base URLs (defaults: api.github.com / github.com).
GITHUB_API_URL=
GITHUB_OAUTH_URL=

# --- Cognitive Mode (optional) ---
# EEG workload classifier service (python backend/, `docker compose --profile bci up`).
BCI_SERVICE_URL=

# --- Observability ---
LOG_LEVEL=info
# Enable OpenTelemetry export (traces + metrics), e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Error tracking (API and worker): a Sentry DSN (free tier is enough). Unset = disabled.
# Only unexpected errors are sent, with credentials redacted; never prompts, bodies or headers.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# GET /status returns 503 when a job has waited longer than this (seconds) to start.
STATUS_MAX_QUEUE_AGE_S=300
