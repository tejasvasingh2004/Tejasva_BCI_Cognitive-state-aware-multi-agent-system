{
  "name": "@neuroflow/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/changelog.mjs && vite --port 5180",
    "build": "node scripts/changelog.mjs && tsc -p tsconfig.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --port 5180",
    "typecheck": "node scripts/changelog.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@neuroflow/contracts": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4"
  }
}
