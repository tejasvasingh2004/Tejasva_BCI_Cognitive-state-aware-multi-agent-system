    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@neuroflow/bus": "workspace:*",
    "@neuroflow/code": "workspace:*",
    "@neuroflow/cognitive": "workspace:*",
    "@neuroflow/contracts": "workspace:*",
    "@neuroflow/db": "workspace:*",
    "@neuroflow/memory": "workspace:*",
    "@neuroflow/models": "workspace:*",
    "@neuroflow/observability": "workspace:*",
    "@neuroflow/orchestrator": "workspace:*",
    "@neuroflow/tools": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "ajv": "^8.17.1",
    "bullmq": "^5.56.0",
    "diff": "^8.0.2",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
